{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CdnOrigin": {
    "ContentRoot": "/cdnroot",
    "Cache": {
      "ImmutablePathPrefixes": [],
      "Revalidate": {
        "Public": true,
        "MaxAge": "12:00:00",
        "SharedMaxAge": "7.00:00:00",
        "MustRevalidate": true
      },
      "Immutable": {
        "Public": true,
        "MaxAge": "365.00:00:00",
        "Immutable": true
      }
    },
    "Cors": {
      "Enabled": true,
      "AllowedOrigins": [],
      "ExposedHeaders": [],
      "AllowCredentials": false,
      "CrossOriginResourcePolicy": "cross-origin",
      "TimingAllowOrigin": false
    },
    "Compression": {
      "Enabled": false,
      "EnableForHttps": true,
      "AdditionalMimeTypes": []
    },
    "ContentTypes": {
      "ServeUnknownFileTypes": false,
      "Mappings": {}
    },
    "Health": {
      "Enabled": true,
      "LivePath": "/health/live",
      "ReadyPath": "/health/ready"
    }
  }
}
